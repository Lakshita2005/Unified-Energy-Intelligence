# Copy to .env and fill in values. Never commit .env.
# Values shown are the defaults; blank values have no default.

# --- Application ---------------------------------------------------------
APP_NAME=price-intelligence-ingestion
# development | test | staging | production
APP_ENV=development

# --- PostgreSQL ----------------------------------------------------------
# Required: DB_HOST, DB_NAME, DB_USER
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
# Optional if using .pgpass / trust authentication
DB_PASSWORD=
# e.g. require, verify-full (blank = libpq default)
DB_SSLMODE=
DB_DRIVER=postgresql+psycopg
# Schema containing the Price Intelligence tables (checked by the health check)
DB_SCHEMA=pi
DB_CONNECT_TIMEOUT_SECONDS=10
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false

# --- Logging -------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# text | json
LOG_FORMAT=text
# Relative paths resolve from the project root
LOG_DIR=logs
LOG_TO_FILE=true
# Console (stdout) logging. Set false for Windows services whose stdout is captured
# to a file by the service wrapper (avoids every line being logged twice).
LOG_TO_CONSOLE=true
LOG_FILE_NAME=ingestion.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# --- HTTP client ---------------------------------------------------------
HTTP_TIMEOUT_SECONDS=30
HTTP_CONNECT_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_FACTOR_SECONDS=1.0
HTTP_BACKOFF_MAX_SECONDS=60
HTTP_USER_AGENT=price-intelligence-ingestion/0.1
HTTP_VERIFY_SSL=true

# --- Open-Meteo ----------------------------------------------------------
# free       = https://api.open-meteo.com/v1/forecast (and archive-api.open-meteo.com), NO API key.
#              NON-COMMERCIAL USE ONLY; fewer than 10,000 API calls a day; data licensed CC BY 4.0,
#              so attribution to Open-Meteo.com is required wherever the data is shown or shared.
# commercial = paid plan; requires OPEN_METEO_API_KEY (requests then go to the customer- hosts).
# The scheduler refuses Open-Meteo schedules if the plan and the key disagree (no silent endpoint switch).
OPEN_METEO_PLAN=free
# Worst-case daily API calls the scheduler may plan for (free plan limit)
OPEN_METEO_DAILY_CALL_LIMIT=10000
# Commercial plan only. Leave EMPTY on the free plan.
OPEN_METEO_API_KEY=
# TOML file listing weather locations (see config/weather_locations.example.toml)
WEATHER_LOCATIONS_FILE=config/weather_locations.toml

# --- NPP (National Power Portal) ----------------------------------------
# Base URL of the dashboard JSON endpoints; change only if NPP moves them.
NPP_BASE_URL=https://npp.gov.in/dashBoard

# --- IEX (Indian Energy Exchange) ----------------------------------------
# Base URL of the market-snapshot / area-price API; change only if IEX moves it.
IEX_API_BASE_URL=https://www.iexindia.com/api/v1

# --- CEA (Central Electricity Authority) ---------------------------------
# Daily coal stock / generation reports (NPP mirror) and monthly reports (cea.nic.in).
CEA_NPP_REPORTS_BASE_URL=https://npp.gov.in/public-reports/cea
CEA_SITE_BASE_URL=https://cea.nic.in

# --- Grid-India (NLDC) -----------------------------------------------------
# Daily PSP workbook listing API and file CDN. Terms of use not yet verified.
GRID_INDIA_API_BASE_URL=https://webapi.grid-india.in/api/v1
GRID_INDIA_CDN_BASE_URL=https://webcdn.grid-india.in

# --- MOSDAC (ISRO SAC) solar / wind energy forecasts ---------------------
# GET <base>/solar?lat=&lon= and <base>/wind?lat=&lon=; no key or login expected.
MOSDAC_API_BASE_URL=https://mosdac.gov.in/apienergy
# TOML file of plant locations ([[location]] tables, weather-location format)
MOSDAC_LOCATIONS_FILE=config/mosdac_locations.toml
MOSDAC_REQUEST_PAUSE_SECONDS=1.0

# --- Scheduler / worker (docs/scheduler.md; needs migration 0011_pi_jobs) ---
# Master switch. While false nothing is checked or queued, whatever config/scheduler.toml says.
SCHEDULER_GLOBAL_ENABLE=false
SCHEDULER_CONFIG_FILE=config/scheduler.toml
SCHEDULER_TIMEZONE=Asia/Kolkata
SCHEDULER_TICK_SECONDS=30
SCHEDULER_RECOVERY_INTERVAL_SECONDS=300
SCHEDULER_JOBS_SCHEMA=pi_jobs
# One rotating log file per process; the manual 'check' / 'once' commands never share the services' files
SCHEDULER_LOG_FILE_NAME=pi-scheduler.log
SCHEDULER_CHECK_LOG_FILE_NAME=pi-scheduler-check.log
WORKER_LOG_FILE_NAME=pi-worker.log
WORKER_ONCE_LOG_FILE_NAME=pi-worker-once.log
WORKER_CONCURRENCY=2
WORKER_POLL_SECONDS=10
WORKER_LEASE_SECONDS=600
WORKER_HEARTBEAT_SECONDS=30
WORKER_SHUTDOWN_GRACE_SECONDS=300
# Optional graceful-stop files (only for hosts that cannot send Ctrl+C, e.g. Task Scheduler)
SCHEDULER_STOP_FILE=
WORKER_STOP_FILE=

# --- Raw storage ---------------------------------------------------------
# Only "local" is implemented
RAW_STORAGE_BACKEND=local
RAW_DATA_DIR=raw_data
RAW_STORAGE_WRITE_METADATA=true
